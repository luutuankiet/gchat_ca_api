# Google Cloud Conversational Analytics Demo - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================
# Google Cloud Configuration
# ============================================================

# Your Google Cloud project ID
# Find this in: Cloud Console → Project dropdown → Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Region where services will be deployed
# Recommended: us-central1 (best support for Vertex AI + Cloud Run)
# Alternatives: us-east1, europe-west1
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================
# Conversational Analytics Agent
# ============================================================

# Your CA agent ID (from BigQuery or Looker)
# How to find:
#   - BigQuery: Console → BigQuery → Gemini → Your Agent → Settings
#   - Looker: Looker Studio → Agent Settings
# Format: Usually a UUID like a1b2c3d4-e5f6-...
CA_AGENT_ID=your-ca-agent-id

# ============================================================
# Vertex AI Reasoning Engine
# ============================================================

# The Reasoning Engine ID from deploying ca_api_agent
# You'll get this after running: ./deployment/deploy-agent.sh
# Format: Just the numeric ID (e.g., 456789)
# Leave empty until after agent deployment
REASONING_ENGINE_ID=

# ============================================================
# Optional: Advanced Configuration
# ============================================================

# Cloud Run service name (default: gchat-connector)
# CLOUD_RUN_SERVICE_NAME=gchat-connector

# Maximum Cloud Run instances (default: 10)
# CLOUD_RUN_MAX_INSTANCES=10

# Cloud Run memory allocation (default: 512Mi)
# CLOUD_RUN_MEMORY=512Mi

# Cloud Run timeout in seconds (default: 300)
# CLOUD_RUN_TIMEOUT=300

# ============================================================
# Local Development Only
# ============================================================

# Flask debug mode (set to "true" for local dev, "false" for production)
# FLASK_DEBUG=true

# Local server port (default: 8080)
# PORT=8080
